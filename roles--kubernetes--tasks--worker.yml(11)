---
- name: Désactiver swap
  command: swapoff -a
  when: ansible_swaptotal_mb | int > 0

- name: Commenter swap dans fstab
  replace:
    path: /etc/fstab
    regexp: '(^.*swap.*$)'
    replace: '# \1'

- name: Installer dépendances système
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - curl
      - gnupg
      - lsb-release
    state: present
    update_cache: yes

# ---------- dépôt Kubernetes stable v1.35 via pkgs.k8s.io ----------

- name: Créer le répertoire des keyrings s'il n'existe pas
  file:
    path: /etc/apt/keyrings
    state: directory
    mode: "0755"

- name: Télécharger et convertir la clé GPG Kubernetes v1.35
  shell: |
    curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.35/deb/Release.key \
      | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
  args:
    creates: /etc/apt/keyrings/kubernetes-apt-keyring.gpg

- name: Donner les droits de lecture sur le keyring
  file:
    path: /etc/apt/keyrings/kubernetes-apt-keyring.gpg
    mode: "0644"

- name: Ajouter le dépôt Kubernetes v1.35
  copy:
    dest: /etc/apt/sources.list.d/kubernetes.list
    content: |
      deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.35/deb/ /
    mode: "0644"

- name: Mettre à jour APT
  apt:
    update_cache: yes

# ---------- installation Docker + kubeadm/kubelet/kubectl (v1.35) ----------

- name: Installer kubeadm, kubelet, kubectl, docker
  apt:
    name:
      - docker.io
      - kubelet
      - kubeadm
      - kubectl
    state: present

- name: Marquer kubelet/kubeadm/kubectl en hold
  apt:
    name:
      - kubelet
      - kubeadm
      - kubectl
    state: present
    mark_hold: yes

# ---------- initialisation du cluster / Calico / Ingress ----------

- name: Initialiser le cluster
  command: kubeadm init --pod-network-cidr=192.168.0.0/16
  args:
    creates: /etc/kubernetes/admin.conf

- name: Créer le dossier .kube pour ubuntu
  file:
    path: /home/ubuntu/.kube
    state: directory
    owner: ubuntu
    group: ubuntu
    mode: "0700"

- name: Copier admin.conf
  copy:
    src: /etc/kubernetes/admin.conf
    dest: /home/ubuntu/.kube/config
    owner: ubuntu
    group: ubuntu
    mode: "0600"

- name: Installer Calico
  become_user: ubuntu
  command: >
    kubectl apply -f https://raw.githubusercontent.com/projectcalico/calico/v3.27.2/manifests/calico.yaml
  environment:
    KUBECONFIG: /home/ubuntu/.kube/config

- name: Installer Ingress NGINX
  become_user: ubuntu
  command: >
    kubectl apply -f https://raw.githubusercontent.com/kubernetes/ingress-nginx/main/deploy/static/provider/baremetal/deploy.yaml
  environment:
    KUBECONFIG: /home/ubuntu/.kube/config

- name: Générer commande join
  command: kubeadm token create --print-join-command
  register: join_cmd
  changed_when: false

- name: Sauvegarder join command
  set_fact:
    k8s_join_command: "{{ join_cmd.stdout }}"
