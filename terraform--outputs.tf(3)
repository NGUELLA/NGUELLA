output "jenkins_public_ip" {
  value       = aws_instance.jenkins.public_ip
  description = "IP publique Jenkins"
}

output "sonarqube_public_ip" {
  value       = aws_instance.sonarqube.public_ip
  description = "IP publique SonarQube"
}

output "nexus_public_ip" {
  value       = aws_instance.nexus.public_ip
  description = "IP publique Nexus"
}

output "k8s_master_public_ip" {
  value       = aws_instance.k8s_master.public_ip
  description = "IP publique master K8s"
}

output "k8s_workers_public_ips" {
  value       = [for w in aws_instance.k8s_worker : w.public_ip]
  description = "IPs publiques workers K8s"
}

output "ansible_bastion_public_ip" {
  value       = aws_instance.ansible_bastion.public_ip
  description = "IP publique bastion/Ansible"
}
