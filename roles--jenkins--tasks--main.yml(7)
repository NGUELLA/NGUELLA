---
- name: Installer Docker
  apt:
    name: docker.io
    state: present
    update_cache: yes

- name: Activer et démarrer Docker
  systemd:
    name: docker
    enabled: yes
    state: started

- name: Ajouter ubuntu au groupe docker
  user:
    name: ubuntu
    groups: docker
    append: yes

- name: Installer Java 17
  apt:
    name: openjdk-17-jdk
    state: present

- name: Ajouter clé Jenkins
  apt_key:
    url: https://pkg.jenkins.io/debian-stable/jenkins.io-2023.key
    state: present

- name: Ajouter dépôt Jenkins
  apt_repository:
    repo: deb https://pkg.jenkins.io/debian-stable binary/
    state: present

- name: Installer Jenkins
  apt:
    name: jenkins
    state: present
    update_cache: yes

- name: Activer Jenkins
  systemd:
    name: jenkins
    enabled: yes
    state: started
