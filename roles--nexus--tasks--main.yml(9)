---
- name: Installer Docker
  apt:
    name: docker.io
    state: present
    update_cache: yes

- name: Activer Docker
  systemd:
    name: docker
    enabled: yes
    state: started

- name: Répertoire Nexus data
  file:
    path: /opt/nexus-data
    state: directory
    mode: "0755"

- name: Lancer Nexus3
  community.docker.docker_container:
    name: nexus
    image: sonatype/nexus3
    state: started
    restart_policy: always
    ports:
      - "8081:8081"
    volumes:
      - /opt/nexus-data:/nexus-data
